# Site / CORS
APP_ORIGIN=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:8080
SERVER_ADDR=:8080
# Comma-separated extras (APP_ORIGIN is always included)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Config file (optional; defaults to ../config/app.yaml relative to server/)
# APP_CONFIG=../config/app.yaml

# MySQL (optional — without it, auth/chat/cms fall back to in-memory / embedded seed)
# Prefer DATABASE_URL; DATABASE_DSN is an alias.
DATABASE_URL=hello:hello@tcp(127.0.0.1:3306)/hello_gutsyang?parseTime=true&loc=UTC&charset=utf8mb4

# Redis (optional — without it, rate limit + cache use in-memory)
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# REDIS_URL=redis://127.0.0.1:6379/0

# Cookie hardening: auto | on | off
COOKIE_SECURE=auto
ADMIN_SESSION_COOKIE=hello_gutsyang_admin_session
CHAT_OWNER_COOKIE=hello_gutsyang_chat_owner

# One-time admin bootstrap (clear after first login)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_PASSWORD_HASH=

# Rate limits
RATE_LIMIT_LOGIN_BURST=10
RATE_LIMIT_LOGIN_WINDOW=5m
RATE_LIMIT_CHAT_BURST=5
RATE_LIMIT_CHAT_WINDOW=30s
RATE_LIMIT_AI_LIST_BURST=60
RATE_LIMIT_AI_LIST_WINDOW=1m
RATE_LIMIT_ADMIN_AI_BURST=30
RATE_LIMIT_ADMIN_AI_WINDOW=1m

# Login lockout
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_WINDOW=15m
LOGIN_LOCKOUT_BLOCK_FOR=15m

# Media / ObjectStore
MEDIA_PROVIDER=local
MEDIA_LOCAL_DIR=./uploads
MEDIA_MAX_UPLOAD_BYTES=10485760
# S3 reserved (MEDIA_PROVIDER=s3)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# DeepSeek
# Available models: deepseek-v4-flash (fast & cheap, default), deepseek-v4-pro
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
