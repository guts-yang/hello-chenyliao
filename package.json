{
  "name": "hello-gutsyang",
  "version": "0.1.0",
  "private": true,
  "description": "gutsyang 的双语个人主页/作品集：Vue 3 前端 + Go 模块化单体 API。",
  "workspaces": [
    "web",
    "utils"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:web": "npm run dev -w web",
    "dev:server": "npm run server",
    "build": "npm run build -w web",
    "build:web": "npm run build -w web",
    "start": "npm run start -w web",
    "lint": "npm run lint -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "npm run test:server",
    "test:server": "go -C server test ./...",
    "server": "go -C server run ./cmd/server",
    "db:up": "docker compose -f config/docker-compose.yml up -d",
    "db:down": "docker compose -f config/docker-compose.yml down",
    "db:migrate": "go -C server run ./cmd/server migrate up",
    "db:migrate:status": "go -C server run ./cmd/server migrate status",
    "auth:hash": "go -C server run ./cmd/server hash"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
